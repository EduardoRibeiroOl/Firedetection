#!/usr/bin/env python3
"""
Backend completo para Raspberry Pi:
- Stream MJPEG em /video  (Picamera2)
- Controle por estado em /control?cmd=
- Panic /state endpoints
- Motor loop em thread que aplica estado continuamente (sem precisar segurar tecla)
"""

from flask import Flask, Response, request, jsonify
from gpiozero import Motor
from picamera2 import Picamera2
import cv2
import threading
import time
import signal
import sys

app = Flask(__name__)

# ---------- CONFIGURAÇÕES ----------
VIDEO_WIDTH = 640
VIDEO_HEIGHT = 480
FRAME_INTERVAL = 0.05  # 20 Hz motor loop

# GPIO / Motores (ajuste pinos se necessário)
motorA = Motor(forward=17, backward=27)
motorB = Motor(forward=22, backward=23)

# Estado compartilhado do robô
current_cmd = "stop"
state_lock = threading.Lock()

# Camera Picamera2
picam2 = None
running = True  # flag global para encerrar threads


# ---------- Funções auxiliares ----------
def set_state(cmd: str):
    global current_cmd
    with state_lock:
        current_cmd = cmd
    app.logger.debug("Estado alterado para: %s", cmd)


def get_state():
    with state_lock:
        return current_cmd


def motor_apply(cmd: str):
    """
    Aplica imediatamente o comando aos motores.
    Chamado dentro do motor_loop (que tem a responsabilidade de manter o estado).
    """
    try:
        if cmd == "up":
            motorA.backward()
            motorB.backward()
        elif cmd == "down":
            motorA.forward()
            motorB.forward()
        elif cmd == "left":
            motorA.backward()
            motorB.forward()
        elif cmd == "right":
            motorA.forward()
            motorB.backward()
        elif cmd == "stop":
            motorA.stop()
            motorB.stop()
        else:
            # comando desconhecido -> stop por segurança
            motorA.stop()
            motorB.stop()
    except Exception as e:
        app.logger.exception("Erro aplicando comando de motor: %s", e)


# ---------- Thread de controle de motores ----------
def motor_loop():
    """Loop que aplica continuamente o estado atual aos motores."""
    app.logger.info("Motor loop iniciado.")
    global running
    last = None
    while running:
        with state_lock:
            cmd = current_cmd
        if cmd != last:
            app.logger.debug("Aplicando novo estado: %s", cmd)
            motor_apply(cmd)
            last = cmd
        # reaplicar continuamente evita que pequenos 'pulsos' interfiram
        time.sleep(FRAME_INTERVAL)
    # Ao sair, garantir parada
    try:
        motorA.stop()
        motorB.stop()
    except:
        pass
    app.logger.info("Motor loop finalizado.")


# ---------- Generador de frames (MJPEG) ----------
def generate_frames():
    """Gera frames JPEG a partir do picam2.capture_array()"""
    global picam2, running
    if picam2 is None:
        app.logger.error("Picamera2 não inicializada.")
        return

    app.logger.info("Iniciando stream MJPEG.")
    while running:
        try:
            frame = picam2.capture_array()
            if frame is None:
                continue
            # opcional: redimensionar se precisar
            # frame = cv2.resize(frame, (VIDEO_WIDTH, VIDEO_HEIGHT))
            ret, jpeg = cv2.imencode(".jpg", frame)
            if not ret:
                continue
            frame_bytes = jpeg.tobytes()
            yield (b"--frame\r\n"
                   b"Content-Type: image/jpeg\r\n\r\n" + frame_bytes + b"\r\n")
        except Exception as e:
            app.logger.exception("Erro ao capturar frame: %s", e)
            time.sleep(0.1)
    app.logger.info("Encerrando generator de frames.")


# ---------- Endpoints Flask ----------
@app.get("/control")
def control():
    """
    Atualiza o estado do robô.
    Uso: /control?cmd=up
    Comandos: up, down, left, right, stop
    """
    cmd = request.args.get("cmd", "").lower()
    if cmd not in ("up", "down", "left", "right", "stop"):
        return jsonify({"status": "error", "msg": "cmd inválido"}), 400

    set_state(cmd)
    return jsonify({"status": "ok", "cmd": cmd})


@app.get("/panic")
def panic():
    """Parada imediata e manter estado em stop."""
    set_state("stop")
    # aplicar imediatamente
    motor_apply("stop")
    return jsonify({"status": "ok", "cmd": "stop"})


@app.get("/state")
def state():
    """Retorna o estado atual para debug."""
    return jsonify({"state": get_state()})


@app.get("/video")
def video_feed():
    """Stream MJPEG contínuo."""
    return Response(generate_frames(), mimetype="multipart/x-mixed-replace; boundary=frame")


# ---------- Inicialização hardware ----------
def init_camera():
    global picam2
    try:
        picam2 = Picamera2()
        config = picam2.create_video_configuration({"size": (VIDEO_WIDTH, VIDEO_HEIGHT)})
        picam2.configure(config)
        picam2.start()
        app.logger.info("Picamera2 iniciada com sucesso.")
    except Exception as e:
        app.logger.exception("Falha ao inicializar Picamera2: %s", e)
        raise


# ---------- Limpeza ao encerrar ----------
def cleanup_and_exit(signum=None, frame=None):
    """Tenta encerrar tudo de forma segura."""
    global running
    app.logger.info("Sinal de encerramento recebido. Limpando...")
    running = False
    # small delay to allow threads to exit gracefully
    time.sleep(0.2)
    try:
        motorA.stop()
        motorB.stop()
    except:
        pass
    try:
        if picam2:
            picam2.stop()
    except:
        pass
    app.logger.info("Finalizando processo.")
    # fechar o Flask / processo
    sys.exit(0)


# Registrar handlers de sinal
signal.signal(signal.SIGINT, cleanup_and_exit)
signal.signal(signal.SIGTERM, cleanup_and_exit)


# ---------- MAIN ----------
if __name__ == "__main__":
    # inicializa hardware
    try:
        init_camera()
    except Exception:
        app.logger.error("Erro na inicialização. Saindo.")
        sys.exit(1)

    # iniciar motor loop
    motor_thread = threading.Thread(target=motor_loop, daemon=True)
    motor_thread.start()

    # inicializar estado padrão
    set_state("stop")

    # rodar flask
    # threaded=True permite tratamento de vídeo e control simultâneo
    app.run(host="0.0.0.0", port=5000, threaded=True)